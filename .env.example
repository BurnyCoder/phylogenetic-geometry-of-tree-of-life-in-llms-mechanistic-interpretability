# Copy to .env and adjust. .env is gitignored.
# Hugging Face cache (models are large; keep them off a small C: drive).
HF_HOME=D:/AI/hf_cache
# uv package cache and copy-link mode (cache is on another drive than the venv).
UV_CACHE_DIR=D:/AI/uv_cache
UV_LINK_MODE=copy
# Large artifacts (activations, TimeTree cache, which must not be redistributed).
DATA_DIR=D:/AI/phylo-geometry
# Hugging Face namespace for uploads.
HF_NAMESPACE=BurnyCoder
